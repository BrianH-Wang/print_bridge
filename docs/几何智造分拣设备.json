{
  "print-bridge-config": 1,
  "exported_at": "2026-09-10 18:53:56",
  "note": "两条链接：/callback 收数值（双向，等前端回分拣格口）、/upload 收图片（单向）。按条码配对合成一条，应答已按设备文档改成 success/code/msg/data。",
  "profile": {
    "name": "分拣设备",
    "ws_port": "8765",
    "data_addr": "0.0.0.0:13213",
    "enable_print": false,
    "enable_data": true,
    "printers": [
      {
        "key": "label",
        "label": "标签",
        "kind": "system",
        "queue": "",
        "host": "",
        "port": 9100,
        "timeout": 10.0
      }
    ],
    "channels": [
      {
        "key": "sorter_data",
        "label": "分拣数值",
        "path": "/callback",
        "flow": "twoway",
        "timeout": 15.0,
        "dispatch": "concurrent",
        "envelope": {
          "success": "{{__success}}",
          "code": "{{__code}}",
          "msg": "{{__message}}",
          "data": "{{__data}}"
        },
        "http_status": "follow_code",
        "responses": {
          "bad_json": {
            "code": 404,
            "message": "服务器接口错误"
          },
          "reply_timeout": {
            "code": 500,
            "message": "服务器逻辑错误"
          },
          "no_client": {
            "code": 500,
            "message": "服务器逻辑错误"
          }
        },
        "mapping": {
          "mode": "pick",
          "on_missing": "error",
          "fields": [
            {
              "source": "code",
              "target": "expressNo",
              "transforms": [],
              "required": true,
              "default": null
            },
            {
              "source": "weight",
              "target": "weightKg",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null
            },
            {
              "source": "length",
              "target": "lengthCm",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null
            },
            {
              "source": "width",
              "target": "widthCm",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null
            },
            {
              "source": "height",
              "target": "heightCm",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null
            }
          ]
        },
        "outbound": null,
        "sample": {
          "code": "CCSL2026083100123",
          "weight": "12.50",
          "height": "35.20",
          "width": "28.00",
          "length": "40.75"
        },
        "pair": {
          "role": "primary",
          "group": "parcel",
          "field": "expressNo",
          "value": "",
          "rename": "",
          "wait": 5.0,
          "keep": 60.0,
          "on_missing": "send_partial",
          "max_pending": 200
        }
      },
      {
        "key": "sorter_image",
        "label": "分拣图片",
        "path": "/upload",
        "flow": "oneway",
        "timeout": 10.0,
        "dispatch": "concurrent",
        "envelope": {
          "success": "{{__success}}",
          "code": "{{__code}}",
          "msg": "{{__message}}",
          "data": "{{__data}}"
        },
        "http_status": "follow_code",
        "responses": {
          "ok": {
            "message": "操作成功"
          }
        },
        "mapping": {
          "mode": "pick",
          "on_missing": "error",
          "fields": [
            {
              "source": "code",
              "target": "expressNo",
              "transforms": [],
              "required": true,
              "default": null
            },
            {
              "source": "file",
              "target": "imageBase64",
              "transforms": [],
              "required": false,
              "default": null
            }
          ]
        },
        "outbound": null,
        "sample": {
          "code": "CCSL2026083100123",
          "file": "iVBORw0KGgo..."
        },
        "pair": {
          "role": "attach",
          "group": "parcel",
          "field": "expressNo",
          "value": "",
          "rename": "",
          "wait": 5.0,
          "keep": 60.0,
          "on_missing": "send_partial",
          "max_pending": 200
        }
      }
    ]
  },
  "http_responses": {}
}