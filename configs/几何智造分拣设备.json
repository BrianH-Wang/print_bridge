          "code": "{{__code}}",
          "msg": "{{__message}}",
          "data": "{{__data}}"
        },
        "http_status": "follow_code",
        "responses": {
          "ok": {
            "message": "操作成功"
          },
          "ok_reply": {
            "message": "操作成功"
          }
        },
        "mapping": {
          "mode": "pick",
          "on_missing": "error",
          "fields": [
            {
              "source": "code",
              "target": "expressNo",
              "transforms": [],
              "required": true,
              "default": null,
              "check": null
            },
            {
              "source": "weight",
              "target": "weight",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null,
              "check": null
            },
            {
              "source": "length",
              "target": "length",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null,
              "check": null
            },
            {
              "source": "width",
              "target": "width",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null,
              "check": null
            },
            {
              "source": "height",
              "target": "height",
              "transforms": [
                "number"
              ],
              "required": false,
              "default": null,
              "check": null
            }
          ]
        },
        "outbound": null,
        "sample": {
          "code": "CCSL2026083100123",
          "weight": "12.50",
          "height": "35.20",
          "width": "28.00",
          "length": "40.75"
        },
        "pair": {
          "role": "primary",
          "group": "parcel",
          "field": "expressNo",
          "value": "",
          "rename": "",
          "wait": 5.0,
          "keep": 60.0,
          "on_missing": "send_partial",
          "max_pending": 200
        },
        "reply_sample": {
          "route": "A",
          "totalCount": 100,
          "currentCount": 1,
          "mainOrderNo": "MO2026083100123"
        },
        "reply_raw": true
      },
      {
        "key": "sorter_image",
        "label": "分拣图片",
        "path": "/upload",
        "flow": "oneway",
        "timeout": 10.0,
        "dispatch": "concurrent",
        "envelope": {
          "success": "{{__success}}",
          "code": "{{__code}}",
          "msg": "{{__message}}",
          "data": "{{__data}}"
        },
        "http_status": "follow_code",
        "responses": {
          "ok": {
            "message": "操作成功"
          },
          "file_too_large": {
            "code": 413,
            "message": "文件超过 2M 限制：{error}"
          },
          "file_invalid": {
            "code": 415,
            "message": "文件解析失败：{error}"
          }
        },
        "mapping": {
          "mode": "pick",
          "on_missing": "error",
          "fields": [
            {
              "source": "code",
              "target": "expressNo",
              "transforms": [],
              "required": true,
              "default": null,
              "check": null
            },
            {
              "source": "file",
              "target": "imageBase64",
              "transforms": [],
              "required": true,
              "default": null,
              "check": {
                "type": "file",
                "max_bytes": 2097152,
                "formats": [
                  "jpg",
                  "png",
                  "pdf"
                ]
              }
            }
          ]
        },
        "outbound": null,
        "sample": {
